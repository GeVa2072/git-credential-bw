#!/bin/bash
#
# git-credential-bw — Git credential helper backed by Bitwarden.
#
# Looks up Git credentials in a Bitwarden vault via the `bw` CLI and returns
# them in the format expected by git-credential. When multiple credentials
# match the requested host, an interactive arrow-key menu lets the user
# pick one.
#
# Setup:
#   1. Install the script somewhere in your PATH (e.g. /usr/local/bin).
#   2. Configure git to use it, optionally chained with the built-in
#      cache helper so credentials are kept in memory for a short while:
#
#        [credential]
#            helper = cache --timeout 900
#            helper = /usr/local/bin/git-credential-bw
#
#   3. (Optional) Pass your Bitwarden username upfront:
#
#        git config --global credential.helper "bw -l user@example.com"
#
# Requirements: bw (Bitwarden CLI), jq, bash 4+.
# The script also depends on /dev/tty for interactive prompts (master
# password, credential selection).

declare -A params

# Interactive arrow-key menu.
# Prints each argument on its own line, highlights the current selection
# in reverse video, and reads Up/Down/Enter from /dev/tty. Returns the
# selected index (0-based) via $?. The caller must redirect stdin/stdout
# to /dev/tty.
select_option() {
    ESC=$(printf "\033")
    cursor_blink_on()  { printf "$ESC[?25h"; }
    cursor_blink_off() { printf "$ESC[?25l"; }
    cursor_to()        { printf "$ESC[$1;${2:-1}H"; }
    print_option()     { printf "   $1 "; }
    print_selected()   { printf "  $ESC[7m $1 $ESC[27m"; }
    get_cursor_row()   { IFS=';' read -sdR -p $'\E[6n' ROW COL; echo ${ROW#*[}; }
    key_input()        { read -s -n3 key 2>/dev/null >&2
                         if [[ $key = $ESC[A ]]; then echo up;    fi
                         if [[ $key = $ESC[B ]]; then echo down;  fi
                         if [[ $key = ""     ]]; then echo enter; fi; }

    # Print blank lines so we can overwrite them in place.
    for opt; do printf "\n"; done

    local lastrow
    local startrow
    lastrow=$(get_cursor_row)
    startrow=$((lastrow - $#))

    # Restore cursor and echo if the user presses Ctrl-C during read -s.
    trap 'cursor_blink_on; stty echo; printf "\n"; exit' 2
    cursor_blink_off

    local selected=0
    while true; do
        local idx=0
        for opt; do
            cursor_to $((startrow + idx))
            if [ "$idx" -eq "$selected" ]; then
                print_selected "$opt"
            else
                print_option "$opt"
            fi
            ((idx++))
        done

        case "$(key_input)" in
            enter) break ;;
            up)    ((selected--))
                   if [ "$selected" -lt 0 ]; then selected=$(($# - 1)); fi ;;
            down)  ((selected++))
                   if [ "$selected" -ge "$#" ]; then selected=0; fi ;;
        esac
    done

    cursor_to "$lastrow"
    printf "\n"
    cursor_blink_on
    return "$selected"
}

# Optional: -l <username> supplies the Bitwarden account to log in as.
if [ "x$1" == "x-l" ]; then
    shift
    bwuser=$1
    shift
fi

op=$1
case "$op" in

capability)
    # Git credential helper protocol v2. We support the capability
    # negotiation itself but declare no optional features (no authtype,
    # no state) — we only return plain username/password pairs.
    echo "version 0"
    ;;

get)
    # Read the credential description from stdin (key=value lines
    # terminated by a blank line or EOF).
    read line
    while [ -n "$line" ]; do
        key=${line%%=*}
        value=${line#*=}
        params[$key]=$value
        read line
    done

    # Only handle HTTPS for now.
    if [ "x${params['protocol']}" != "xhttps" ]; then
        exit
    fi
    if [ -z "${params["host"]}" ]; then
        exit
    fi

    # --- Bitwarden session management -------------------------------------
    # Ensure the vault is unlocked. If locked or logged out, prompt for
    # credentials on /dev/tty. The session key lives only in memory for
    # the duration of this process; no secrets are written to disk.
    bw_status=$(bw status --raw 2>/dev/null | jq -r '.status')
    case "$bw_status" in
        "unauthenticated")
            BW_SESSION=$(bw login --raw < /dev/tty)
            if [ $? -ne 0 ]; then
                echo "Failed to login to Bitwarden" > /dev/stderr
                exit 1
            fi
            export BW_SESSION
            ;;
        "locked")
            BW_SESSION=$(bw unlock --raw < /dev/tty)
            if [ -z "$BW_SESSION" ]; then
                echo "Failed to unlock Bitwarden vault" > /dev/stderr
                exit 1
            fi
            export BW_SESSION
            ;;
    esac

    # --- Bitwarden lookup -------------------------------------------------
    # Find login items whose URI matches the requested host and that
    # have a custom field named "access_token". The access_token field
    # value is used as the git password.
    bw sync < /dev/tty > /dev/null 2>&1

    items_json=$(bw list items --url "${params["host"]}" \
        | jq 'map(select(any(.fields[]?; .name == "access_token")))')
    count=$(echo "$items_json" | jq 'length')

    if [ "$count" -eq 0 ]; then
        echo "Couldn't find host in Bitwarden DB." > /dev/stderr
        exit 1
    fi

    if [ "$count" -gt 1 ]; then
        mapfile -t labels < <(echo "$items_json" \
            | jq -r '.[] | "\(.name) (\(.login.username // ""))"')

        printf 'Multiple credentials found for %s (up/down to move, Enter to select):\r\n' \
            "${params["host"]}" > /dev/tty
        select_option "${labels[@]}" < /dev/tty > /dev/tty
        choice=$?

        item=$(echo "$items_json" | jq -r ".[$choice]")
    else
        item=$(echo "$items_json" | jq -r '.[0]')
    fi

    user=$(echo "$item" | jq -r '.login.username')
    pass=$(echo "$item" | jq -r '.fields[] | select(.name == "access_token").value')

    if [ "x$user" == "x" ] || [ "x$pass" == "x" ]; then
        echo "Couldn't retrieve credentials from Bitwarden." > /dev/stderr
        exit 1
    fi

    echo "username=$user"
    echo "password=$pass"
    ;;

esac
